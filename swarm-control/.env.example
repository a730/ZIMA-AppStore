# ─── SwarmClaw Configuration ───
# URL of the SwarmClaw API (the Next.js app server)
SWARMCLAW_API_URL=http://swarmclaw:3456
# API key for authenticating with SwarmClaw (used by CEO/boss agent and bridge)
SWARMCLAW_API_KEY=auto

# ─── Mission Control Configuration ───
MC_PORT=3000
MC_AUTH_USER=admin
MC_AUTH_PASS=$(openssl rand -base64 12)
MC_API_KEY=$(openssl rand -base64 32)

# ─── Gateway Bridge ───
# The bridge exposes an OpenClaw-compatible gateway WS at this port
GATEWAY_BRIDGE_PORT=18789
# Poll interval for syncing agents from SwarmClaw (ms)
AGENT_SYNC_INTERVAL_MS=5000
# Browser-accessible WebSocket URL for the gateway bridge
# For local deployments: ws://localhost:18789
# For remote/VPS: wss://your-domain.com:18789
NEXT_PUBLIC_GATEWAY_URL=ws://localhost:18789
